# ═══════════════════════════════════════════════════════════
# HUBBLE — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local nem .env
#
# Este arquivo está versionado como template.
# Variáveis obrigatórias vs opcionais estão marcadas abaixo.
# ═══════════════════════════════════════════════════════════

# ------------------------------
# OBRIGATÓRIAS
# ------------------------------
# Encontre em: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-privada-server-only

# ------------------------------
# OPCIONAIS
# ------------------------------
# APIs externas
TMDB_API_KEY=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Observabilidade
SENTRY_DSN=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=hubble.local

# Automação / jobs
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HUBBLE
