# ═══════════════════════════════════════════════════════════
# HUBBLE — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local

# ═══════════════════════════════════════════════════════════
# SUPABASE (obrigatório)
# ═══════════════════════════════════════════════════════════
# Encontre em: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-privada-server-only

# ═══════════════════════════════════════════════════════════
# APIS EXTERNAS (opcionais, mas recomendadas)
# ═══════════════════════════════════════════════════════════

# TMDB (filmes + séries) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# AniList (anime + manga) — API é pública, mas OAuth para listas privadas
# https://anilist.co/settings/developer
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════
# OBSERVABILIDADE (opcional)
# ═══════════════════════════════════════════════════════════
# Sentry — https://sentry.io
SENTRY_DSN=

# Plausible — https://plausible.io
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=hubble.local

# ═══════════════════════════════════════════════════════════
# AUTOMAÇÃO (opcional)
# ═══════════════════════════════════════════════════════════
# Token para autenticar pg_cron → Edge Function ingest-aodb
# Gere com: openssl rand -hex 32
CRON_SECRET=

# ═══════════════════════════════════════════════════════════
# APP
# ═══════════════════════════════════════════════════════════
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HUBBLE
